{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/app.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend/src/app.js"
    },
    {
      "src": "/reports/(.*)",
      "dest": "backend/src/app.js"
    },
    {
      "src": "/((?!api|uploads|reports).*)",
      "dest": "/frontend/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api|uploads|reports).*)",
      "dest": "/frontend/index.html"
    }
  ]
}
